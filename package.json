    "sorb",
    "figma",
    "agents"
  ],
  "homepage": "https://github.com/metatoy/sorb-tap#readme",
  "bugs": "https://github.com/metatoy/sorb-tap/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metatoy/sorb-tap.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
